<!DOCTYPE html>
<html lang="hr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Obiteljsko stablo Tandara</title>

<style>
body{
    margin:0;
    font-family:Arial, Helvetica, sans-serif;
    background:#e7c191;
}

.container{
    display:flex;
    min-height:100vh;
}

/* SIDEBAR */
.sidebar{
    width:302px;
    background:#ddb274;
    border-right:4px solid #7a7a7a;
    box-sizing:border-box;
    display:flex;
    flex-direction:column;
    align-items:center;
    padding-top:10px;
}

.menu-item{
    text-align:center;
    cursor:pointer;
    padding:5px;
}

.menu-item:hover{
    background:#cfa86a;
    border-radius:8px;
}

/* CONTENT */
.content{
    flex:1;
    padding:20px;
    display:block;
    max-width: calc(100% - 302px);
}

.page{
    display:none;
}

.page.active{
    display:block;
}

/* HOTSPOTOVI */
.hs{
    position:absolute;
    cursor:pointer;
    border:3px solid red !important;
    background-color:rgba(255,0,0,0.25) !important;
}

.hs-jurina{ top:26.5%; left:6%; width:18%; height:9%; }
.hs-petrova{ top:26.5%; left:32%; width:18%; height:9%; }
.hs-antina{ top:42.5%; left:6%; width:18%; height:9%; }
.hs-matina{ top:42.5%; left:32%; width:18%; height:9%; }

/* MOBITEL */
@media(max-width:900px){
    .container{
        flex-direction:column;
    }

    .sidebar{
        width:100%;
        border-right:none;
        border-bottom:4px solid #7a7a7a;
    }

    .content{
        max-width:100%;
        width:100%;
        padding:10px;
    }
}

@media(max-width:600px){
    #home img{
        width:auto;
        height:100vh;
        transform:rotate(-90deg);
        transform-origin:center;
        position:absolute;
        left:50%;
        top:50%;
        translate:-50% -50%;
    }

    .hs{
        transform:rotate(-90deg);
    }
}

/* PDF FULLSCREEN */
.pdf-fullscreen {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background: #000;
    z-index: 99999;
    display: none;
    flex-direction: column;
}

.pdf-fullscreen.active {
    display: flex;
}

.pdf-fullscreen iframe {
    flex: 1;
    width: 100%;
    border: none;
    background: white;
}

.pdf-close {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 45px;
    cursor: pointer;
}

/* VISITOR BOX */
.visitor-box{
    width:100%;
    background:#f3e2c3;
    padding:20px 0;
    box-sizing:border-box;
    flex:1;
    display:flex;
    flex-direction:column;
    align-items:center;
}
</style>
   <script>
function showPage(id, el){

    document.querySelectorAll('.page').forEach(page=>{
        page.classList.remove('active');
    });

    document.getElementById(id).classList.add('active');

    document.querySelectorAll('.menu-item').forEach(item=>{
        item.classList.remove('active');
    });

    if(el){
        el.classList.add('active');
    }
}

window.onload=function(){
    showPage('home');
}
</script>

</head>

<body>

<div class="container">

    <!-- SIDEBAR -->
    <div class="sidebar">

        <!-- SAMO HOME -->
        <div class="menu-item" onclick="showPage('home', this)">
            <img src="home.png" alt="Početna" style="width:80px;">
        </div>

    </div>

    <!-- CONTENT -->
    <div class="content">
               <!-- HOME -->
        <div id="home" class="page" style="position:relative;">

            <img src="family-tree.png?v=1" style="width:100%; display:block;">

            <div class="hs hs-jurina" onclick="window.location.href='jurinagrana.html'"></div>
            <div class="hs hs-petrova" onclick="window.location.href='petrovagrana.html'"></div>
            <div class="hs hs-antina" onclick="window.location.href='antinagrana.html'"></div>
            <div class="hs hs-matina" onclick="window.location.href='matinagrana.html'"></div>

        </div>

        <!-- HR -->
        <div id="hr" class="page">

            <iframe class="pdf-viewer" src="tandararod.pdf"></iframe>

        </div>

        <!-- EN -->
        <div id="en" class="page">

            <iframe class="pdf-viewer" src="genealogy.pdf"></iframe>

        </div>

    </div>
</div>

<!-- PDF OVERLAY -->
<div id="pdfOverlay" class="pdf-fullscreen">
    <iframe id="pdfFrame" src=""></iframe>
</div>

</body>
</html>

